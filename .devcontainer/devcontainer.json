{
  "name": "Right to Know (Alaveteli theme)",
  "dockerComposeFile": "../compose.yaml",
  "service": "app",
  "workspaceFolder": "/alaveteli-themes/righttoknow",
  "shutdownAction": "stopCompose",
  // Waits for the app to finish starting, so the first command you run works. Gives up after START_LIMIT (compose.yaml).
  "postStartCommand": ["sh", ".devcontainer/wait-for-app.sh", "app", "setup.sh and Rails", "curl", "-fs", "-o", "/dev/null", "http://localhost:3000/"],
  // MailHog runs in its own container, so it's forwarded from there
  "forwardPorts": [3000, "mailhog:8025"],
  "portsAttributes": {
    "3000": { "label": "Rails (Right to Know)", "onAutoForward": "notify" },
    "mailhog:8025": { "label": "MailHog (email)", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "manuelpuyol.erb-linter",
        "EditorConfig.EditorConfig"
      ]
    }
  }
}
