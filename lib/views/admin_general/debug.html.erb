<% @title = "Debug" %>

<h1><%= @title %></h1>

<p>You are <%= @admin_current_user %></p>

<h2>Version numbers</h2>

<%
  github_origin = "https://github.com/openaustralia/alaveteli/tree/"
  revision_file = Rails.root.join('REVISION')
  branch_file   = Rails.root.join('BRANCH')
  current_commit = revision_file.exist? ? revision_file.read.strip : @current_commit
  current_branch = branch_file.exist?   ? branch_file.read.strip   : @current_branch
%>

<p>
  Alaveteli version: <%= @current_version %>
  <br>
  <% if current_branch.blank? || current_branch == "(no branch)" %>
    Alaveteli branch: <%= current_branch.presence || '(unknown)' %>
  <% else %>
    Alaveteli branch: <%= link_to current_branch, github_origin + current_branch %>
  <% end %>
  <br>
  <% if current_commit.blank? %>
    Alaveteli commit: (unknown)
  <% else %>
    Alaveteli commit: <%= link_to current_commit, github_origin + current_commit %>
  <% end %>
  <br>
  RUBY_VERSION <%= RUBY_VERSION %>
  <br>
  Rails::VERSION::STRING <%= Rails::VERSION::STRING %>
  <br>
  Xapian::version_string <%= Xapian::version_string %>
</p>

<h2>Configuration</h2>

<p>
  Rails env: <%= Rails.env %>
  <br>
  Rails root: <%= Rails.root %>
</p>

<h2>Environment variables</h2>
<table>
  <% @request_env.each do |k,v| %>
    <tr><td><%= k %></td><td><%= v %></td></tr>
  <% end %>
</table>

<h2>Parameters</h2>
<table>
  <% params.each do |k,v| %>
    <tr><td><%= k %></td><td><%= v %></td></tr>
  <% end %>
</table>

<h2>Session</h2>
<table>
  <% session.to_hash.each do |k,v| %>
    <tr><td><%= k %></td><td><%= v %></td></tr>
  <% end %>
</table>
