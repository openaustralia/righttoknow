    <div class="oaf-footer__grid oaf-footer__grid--attribution">
      <div class="oaf-footer__attribution">
        <p class="oaf-footer__attribution-intro">Built and maintained by</p>
        <a href="https://www.oaf.org.au/" class="oaf-footer__wordmark">
          <%= image_tag 'footer/oaf-wordmark-white.svg', alt: 'OpenAustralia Foundation', width: 267, height: 24 %>
