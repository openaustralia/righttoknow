<div class="oaf-footer" role="contentinfo">
  <div class="oaf-footer__inner">

    <div class="oaf-footer__grid oaf-footer__grid--site">
      <div class="oaf-footer__about">
        <h2 class="oaf-footer__site-name"><%= site_name %></h2>
        <div class="oaf-footer__site-description">
          <p>A site to help anyone submit a Freedom of Information request. <%= site_name %> also publishes and archives requests and responses, building a massive archive of information.</p>
          <p>Powered by <%= link_to 'Alaveteli', help_alaveteli_path %>.</p>
        </div>
      </div>

      <nav class="oaf-footer__links">
        <ul>
          <li><%= link_to 'Make a request', select_authority_path %></li>
          <li><%= link_to 'Browse request library', request_list_successful_path %></li>
          <li><%= link_to 'View authorities', list_public_bodies_default_path %></li>
          <% if feature_enabled?(:alaveteli_pro) %>
            <li><%= link_to 'Journalist?', account_request_index_path %></li>
          <% end %>
          <% if feature_enabled?(:pro_pricing) %>
            <li><%= link_to 'Pro Terms', pro_page_path(:id => 'legal') %></li>
          <% end %>
        </ul>
        <ul>
          <li><%= link_to 'Help', help_path %></li>
          <li><%= link_to 'House Rules', help_house_rules_path %></li>
          <li><%= link_to 'Contact us', help_contact_path %></li>
          <li><%= link_to 'Privacy', help_privacy_path %></li>
          <li><%= link_to 'API', help_api_path %></li>
        </ul>
      </nav>

      <div class="oaf-footer__donate">
        <p>Your donations keep this site and others like it running</p>
        <a href="https://www.oaf.org.au/donate/" class="oaf-footer__donate__button">Donate now</a>
      </div>
    </div>

    <hr class="oaf-footer__divider">

    <div class="oaf-footer__row oaf-footer__services">
      <h2 class="oaf-footer__eyebrow">Other services</h2>
      <ul class="oaf-footer__services__list">
        <li><a href="https://www.planningalerts.org.au">Planning Alerts</a></li>
        <li><a href="https://theyvoteforyou.org.au">They Vote for You</a></li>
        <li><a href="https://www.openaustralia.org.au">OpenAustralia.org.au</a></li>
      </ul>
    </div>

