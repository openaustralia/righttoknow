<%# Theme override of core alaveteli_pro/info_requests/_new_request_advice. %>
<%# Core says every authority has the site-wide reply_late_after_days; this %>
<%# shows the chosen authority's own deadline and day basis instead. Only the %>
<%# deadline sentence differs from core. When the page is rendered for a batch, %>
<%# with no authority chosen, or for an authority with no jurisdiction tag, %>
<%# it shows neutral wording with no day count. alaveteli_pro/advice_deadline.js %>
<%# swaps the sentence back to the neutral wording if the authority is changed %>
<%# in the page, because this partial is only rendered once. %>
<% neutral_deadline = _("Remember, public authorities have a legal deadline " \
                        "to respond to FOI requests. It depends on the " \
                        "authority.") %>
<% advice_body = @info_request_batch.present? ? nil : @info_request&.public_body %>
<% content_for :javascript do %>
  <%= javascript_include_tag 'alaveteli_pro/advice_deadline' %>
<% end %>
<p>
  <%= _("<strong>Can I request information about myself?</strong> " \
        "<a href=\"{{url}}\">No!</a>",
        :url => help_requesting_path(:anchor => "data_protection").html_safe) %>
</p>
<p>
  <strong>
    <%= _("Are you sure the information you’re after isn’t available " \
       "elsewhere?") %>
  </strong>
  <%= _("Check the authority’s responses on {{site_name}} or conduct " \
        "a quick Internet search.", site_name: site_name) %>
</p>
<p>
  <%= _("Once you’re happy with your request, click preview and send.") %>
  <strong id="js-advice-deadline"
          data-neutral-text="<%= neutral_deadline %>">
  <% if advice_body.nil? || advice_body.jurisdiction.nil? %>
      <%= neutral_deadline %>
  <% elsif advice_body.working_or_calendar_days == 'working' %>
      <%= _("Remember, this authority has {{late_number_of_days}} " \
            "working days to respond to FOI requests.",
            late_number_of_days: advice_body.reply_late_after_days) %>
  <% else %>
      <%= _("Remember, this authority has {{late_number_of_days}} " \
            "calendar days to respond to FOI requests.",
            late_number_of_days: advice_body.reply_late_after_days) %>
  <% end %>
  </strong>
</p>
<p>
  <%= _('Once the privacy period ends, everything that you enter on ' \
        'this page, including <strong>your name</strong>, will be ' \
        '<strong><a href="{{url}}">displayed publicly</a></strong> on this ' \
        'website.',
        :url => help_privacy_path(:anchor => "public_request").html_safe) %>
</p>
