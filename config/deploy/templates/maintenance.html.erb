<!doctype html>
<html lang="en">

  <head>

    <title>Right to Know is briefly offline</title>

    <meta charset="utf-8">
    <meta name="viewport" content="initial-scale=1, width=device-width">
    <meta name="robots" content="noindex, nofollow">

    <style>

      *, *::before, *::after {
        box-sizing: border-box;
      }

      * {
        margin: 0;
      }

      html {
        font-size: 16px;
      }

      body {
        background: #f3f1eb;
        border-top: 6px solid #00dcf0;
        color: #333333;
        display: grid;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        font-size: 1.125rem;
        line-height: 1.5;
        min-height: calc(100vh - 6px);
        place-items: center;
      }

      main {
        display: grid;
        gap: 1.5em;
        padding: 2em;
        place-items: center;
        text-align: center;
      }

      main header {
        width: min(100%, 10em);
      }

      main header svg {
        height: auto;
        max-width: 100%;
        width: 100%;
      }

      main article {
        width: min(100%, 32em);
      }

      main h1 {
        font-size: 1.5em;
        font-weight: 700;
        margin-bottom: 0.5em;
      }

      main p + p {
        margin-top: 1em;
      }

    </style>

  </head>

