# frozen_string_literal: true

# Runtime gems required by the RightToKnow theme at boot.
#
# Uploaded by `themes:pre_bundle_setup` in config/deploy.rb and merged into
# Alaveteli's Gemfile at deploy time via `eval_gemfile`. The theme's main
# Gemfile holds dev/deployment tooling (capistrano, rubocop, guard) — only
# production-runtime gems belong here.

source 'https://rubygems.org'

# Error monitoring (initialised in lib/sentry_init.rb). Pinned to a minor
# version because the server re-resolves the bundle on each deploy (no
# committed lockfile covers these gems), so a loose pin could pull a new
# major release in silently on an unrelated deploy.
gem 'sentry-rails', '~> 6.7'
gem 'sentry-ruby', '~> 6.7'
gem 'sentry-sidekiq', '~> 6.7'
